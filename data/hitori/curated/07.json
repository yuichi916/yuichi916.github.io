:true,"conflict":false,"src":["sou-sou-fukushima.jp","tif.ne.jp"],"urls":["https://sou-sou-fukushima.jp/spot/1453","https://www.tif.ne.jp/hontabi/info.html?info=62"]},{"k":"closed_days","v":"ふたばの湯 祐は無休。","n":1,"official":true,"conflict":false,"src":["sou-sou-fukushima.jp","tif.ne.jp"],"urls":["https://sou-sou-fukushima.jp/spot/1453","https://www.tif.ne.jp/hontabi/info.html?info=62"]},{"k":"price","v":"温浴施設の一般料金は700円、小学生以下350円。","n":1,"official":true,"conflict":false,"src":["sou-sou-fukushima.jp","tif.ne.jp"],"urls":["https://sou-sou-fukushima.jp/spot/1453","https://www.tif.ne.jp/hontabi/info.html?info=62"]},{"k":"facilities","v":"男湯・女湯の双方にサウナがあり、光明石を使う人工温泉。","n":1,"official":true,"conflict":false,"src":["sou-sou-fukushima.jp","tif.ne.jp"],"urls":["https://sou-sou-fukushima.jp/spot/1453","https://www.tif.ne.jp/hontabi/info.html?info=62"]},{"k":"access","v":"福島県双葉郡双葉町大字中野字堂ノ前27、駐車場あり。","n":1,"official":true,"conflict":false,"src":["sou-sou-fukushima.jp","tif.ne.jp"],"urls":["https://sou-sou-fukushima.jp/spot/1453","https://www.tif.ne.jp/hontabi/info.html?info=62"]},{"k":"conditions","v":"食事処 貞は11:00〜21:00、20:30ラストオーダーだが、15:00〜17:00はドリンクのみ提供し月曜休。","n":1,"official":true,"conflict":false,"src":["sou-sou-fukushima.jp","tif.ne.jp"],"urls":["https://sou-sou-fukushima.jp/spot/1453","https://www.tif.ne.jp/hontabi/info.html?info=62"]},{"k":"solo_insight","v":{"title":"双葉の湯 祐は20時30分最終入場と15〜17時ドリンクのみの食事処を分ける","insight":"「ふたばの湯 祐は14:00〜21:00、最終入場は20:30。」で「ふたばの湯 祐は無休。」なので、入浴だけなら20時30分前の到着を組みます。「温浴施設の一般料金は700円、小学生以下350円。」で、「男湯・女湯の双方にサウナがあり、光明石を使う人工温泉。」です。食事を重ねる日は「食事処 貞は11:00〜21:00、20:30ラストオーダーだが、15:00〜17:00はドリンクのみ提供し月曜休。」という別条件を確認します。「福島県双葉郡双葉町大字中野字堂ノ前27、駐車場あり。」の複合施設として、入浴と食事の順番を分ける一人の滞在計画です。","anchors":["さくらの里双葉 ふたばの湯 祐","ふたばの湯 祐は14:00〜21:00、最終入場は20:30。","ふたばの湯 祐は無休。","温浴施設の一般料金は700円、小学生以下350円。","男湯・女湯の双方にサウナがあり、光明石を使う人工温泉。","福島県双葉郡双葉町大字中野字堂ノ前27、駐車場あり。","食事処 貞は11:00〜21:00、20:30ラストオーダーだが、15:00〜17:00はドリンクのみ提供し月曜休。"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["sou-sou-fukushima.jp","tif.ne.jp"],"urls":["https://sou-sou-fukushima.jp/spot/1453","https://www.tif.ne.jp/hontabi/info.html?info=62"]}]},"n5537870457":{"checked":"2026-08-12","facts":[{"conflict":false,"k":"status","n":1,"official":false,"src":["yuru-to.net"],"urls":["https://yuru-to.net/detail.php?oid=4225"],"v":"closed_temporarily"},{"conflict":false,"k":"city","n":1,"official":false,"src":["city.iwaki.lg.jp"],"urls":["https://www.city.iwaki.lg.jp/www/genre/1465520407481/index.html","https://www.city.iwaki.lg.jp/www/contents/1472535415293/index.html"],"v":"いわき市"},{"conflict":false,"k":"status","n":1,"official":false,"src":["kyowa-groupnet.jp"],"urls":["https://www.kyowa-groupnet.jp/tabito-ofukuro/"],"v":"open"},{"conflict":false,"k":"closed_days","n":1,"official":false,"src":["instagram.com"],"urls":["https://www.instagram.com/ofukuro_yado/"],"v":"毎月第3水曜日"},{"conflict":false,"k":"hours","n":1,"official":false,"src":["yuru-to.net"],"urls":["https://yuru-to.net/detail.php?oid=4225"],"v":"11:00-20:00(受付終了19:00)"},{"conflict":false,"k":"price","n":1,"official":false,"src":["yuru-to.net"],"urls":["https://yuru-to.net/detail.php?oid=4225"],"v":500},{"conflict":false,"k":"closed_days","n":1,"official":false,"src":["yuru-to.net"],"urls":["https://yuru-to.net/detail.php?oid=4225"],"v":"第3水曜日（要事前問合せ）"}]},"n6512057685":{"checked":"2026-08-22","facts":[{"k":"facility_identity","v":"高湯温泉共同浴場 あったか湯","n":1,"official":true,"conflict":false,"src":["city.fukushima.fukushima.jp"],"urls":["https://www.city.fukushima.fukushima.jp/shisetsu/kanko/2149.html","https://www.city.fukushima.fukushima.jp/soshiki/5/1019/2/3492.html"]},{"k":"opening_hours","v":"開館時間は9:00〜21:00。","n":1,"official":true,"conflict":false,"src":["city.fukushima.fukushima.jp"],"urls":["https://www.city.fukushima.fukushima.jp/shisetsu/kanko/2149.html","https://www.city.fukushima.fukushima.jp/soshiki/5/1019/2/3492.html"]},{"k":"closed_days","v":"木曜日が休館で、祝日の場合は翌日。営業時間・休館日は臨時変更の場合があり、繁忙期は休まず営業する場合がある。","n":1,"official":true,"conflict":false,"src":["city.fukushima.fukushima.jp"],"urls":["https://www.city.fukushima.fukushima.jp/shisetsu/kanko/2149.html","https://www.city.fukushima.fukushima.jp/soshiki/5/1019/2/3492.html"]},{"k":"price","v":"12歳以上は500円、1歳以上12歳未満は250円。","n":1,"official":true,"conflict":false,"src":["city.fukushima.fukushima.jp"],"urls":["https://www.city.fukushima.fukushima.jp/shisetsu/kanko/2149.html","https://www.city.fukushima.fukushima.jp/soshiki/5/1019/2/3492.html"]},{"k":"access","v":"福島市町庭坂字高湯25。福島西IC・福島飯坂ICから車で約30分、JR福島駅西口から高湯温泉行きバス約40分で高湯温泉駅下車、駐車場38台。","n":1,"official":true,"conflict":false,"src":["city.fukushima.fukushima.jp"],"urls":["https://www.city.fukushima.fukushima.jp/shisetsu/kanko/2149.html","https://www.city.fukushima.fukushima.jp/soshiki/5/1019/2/3492.html"]},{"k":"facilities","v":"全て露天風呂で、木と岩を基調とする男女露天風呂がある。","n":1,"official":true,"conflict":false,"src":["city.fukushima.fukushima.jp"],"urls":["https://www.city.fukushima.fukushima.jp/shisetsu/kanko/2149.html","https://www.city.fukushima.fukushima.jp/soshiki/5/1019/2/3492.html"]},{"k":"conditions","v":"貸切露天風呂は50分1,500円。","n":1,"official":true,"conflict":false,"src":["city.fukushima.fukushima.jp"],"urls":["https://www.city.fukushima.fukushima.jp/shisetsu/kanko/2149.html","https://www.city.fukushima.fukushima.jp/soshiki/5/1019/2/3492.html"]},{"k":"solo_insight","v":{"title":"高湯温泉共同浴場 あったか湯は21時閉館を福島駅西口バス40分と露天風呂で組む","insight":"「開館時間は9:00〜21:00。」を終点に、「木曜日が休館で、祝日の場合は翌日。営業時間・休館日は臨時変更の場合があり、繁忙期は休まず営業する場合がある。」ため当日の案内も確認します。「12歳以上は500円、1歳以上12歳未満は250円。」で、個別料金の「貸切露天風呂は50分1,500円。」とは分けます。「JR福島駅西口から高湯温泉行きバス約40分」で高湯温泉駅へ入るか、ICから車約30分と38台駐車を選び、木と岩を基調とする男女露天風呂へ向かう計画です。","anchors":["高湯温泉共同浴場 あったか湯","開館時間は9:00〜21:00。","木曜日が休館で、祝日の場合は翌日。営業時間・休館日は臨時変更の場合があり、繁忙期は休まず営業する場合がある。","12歳以上は500円、1歳以上12歳未満は250円。","福島市町庭坂字高湯25。福島西IC・福島飯坂ICから車で約30分、JR福島駅西口から高湯温泉行きバス約40分で高湯温泉駅下車、駐車場38台。","全て露天風呂で、木と岩を基調とする男女露天風呂がある。","貸切露天風呂は50分1,500円。"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["city.fukushima.fukushima.jp"],"urls":["https://www.city.fukushima.fukushima.jp/shisetsu/kanko/2149.html","https://www.city.fukushima.fukushima.jp/soshiki/5/1019/2/3492.html"]}]},"n944809342":{"checked":"2026-08-11","facts":[{"conflict":false,"k":"access","n":1,"official":false,"src":["aizu-shizen.jp"],"urls":["https://www.aizu-shizen.jp/aizusizennoie"],"v":"public"},{"conflict":false,"k":"reservation","n":1,"official":false,"src":["aizu-shizen.jp"],"urls":["https://www.aizu-shizen.jp/"],"v":"required"},{"conflict":false,"k":"closed_days","n":1,"official":false,"src":["tif.ne.jp"],"urls":["https://www.tif.ne.jp/kyoiku/sisetu/disp.html?id=30"],"v":"月曜日・年末年始"}]},"r8012303":{"checked":"2026-08-12","facts":[{"conflict":false,"k":"price","n":1,"official":false,"src":["yuru-to.net"],"urls":["https://yuru-to.net/detail.php?oid=40063"],"v":200},{"conflict":false,"k":"hours","n":1,"official":true,"src":["city.kitakata.fukushima.jp"],"urls":["https://www.city.kitakata.fukushima.jp/map/10.html"],"v":"9:00〜21:00（入浴10:00〜21:00、最終入館20:30）"},{"conflict":false,"k":"closed_days","n":1,"official":true,"src":["city.kitakata.fukushima.jp"],"urls":["https://www.city.kitakata.fukushima.jp/map/10.html"],"v":"毎週月曜日（祝日の場合は翌日）、12月31日〜1月3日"},{"conflict":false,"k":"city","n":1,"official":false,"src":["yuru-to.net"],"urls":["https://yuru-to.net/detail.php?oid=40063"],"v":"喜多方市"},{"conflict":false,"k":"status","n":1,"official":false,"src":["yuru-to.net"],"urls":["https://yuru-to.net/detail.php?oid=40063"],"v":"closed_temporarily"},{"conflict":false,"k":"hours","n":1,"official":false,"src":["yuru-to.net"],"urls":["https://yuru-to.net/detail.php?oid=40063"],"v":"10:00-21:00(受付終了20:30)"},{"conflict":false,"k":"closed_days","n":1,"official":false,"src":["yuru-to.net"],"urls":["https://yuru-to.net/detail.php?oid=40063"],"v":"月曜日（祝日なら翌日）、年末年始"}]},"w1021675764":{"checked":"2026-08-22","facts":[{"k":"context","v":"旅館鶴亀荘に隣接する温泉です。","n":1,"official":
.jp/life/facilities.html"],"v":"public"},{"conflict":false,"k":"price","n":1,"official":false,"src":["u-travel.hateblo.jp"],"urls":["https://u-travel.hateblo.jp/entry/aogashima-5"],"v":300},{"conflict":false,"k":"wash_area","n":1,"official":false,"src":["iko-yo.net"],"urls":["https://iko-yo.net/facilities/45822"],"v":"yes"},{"conflict":false,"k":"status","n":1,"official":false,"src":["x.com"],"urls":["https://x.com/Aogashima_Vill/status/1978608958119268485"],"v":"closed_temporarily"},{"conflict":false,"k":"payment_method","n":1,"official":false,"src":["wadablog.com"],"urls":["https://wadablog.com/travel/post-112.php"],"v":"counter_person"},{"conflict":false,"k":"bring_towel","n":1,"official":false,"src":["wadablog.com"],"urls":["https://wadablog.com/travel/post-112.php"],"v":"rental"},{"conflict":false,"k":"clientele","n":1,"official":false,"src":["wadablog.com"],"urls":["https://wadablog.com/travel/post-112.php"],"v":"local"},{"conflict":false,"k":"solo_ok","n":1,"official":false,"src":["wadablog.com"],"urls":["https://wadablog.com/travel/post-112.php"],"v":"yes"},{"k":"solo_insight","v":{"title":"青ヶ島村ふれあいサウナの来館計画","insight":"平日は16:00開館、土日祝は14:00開館で閉館は20:00、入館は19:00までと案内されています。毎週水曜日は休館日のため、訪問日は開館日を選び、入館締切の19:00前に到着する具体的な時刻を決めてから出発してください。","anchors":["平日16:00-20:00","土日祝14:00-20:00","入館は19:00まで","毎週水曜日"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["vill.aogashima.tokyo.jp","u-travel.hateblo.jp","iko-yo.net","x.com","wadablog.com"],"urls":["https://www.vill.aogashima.tokyo.jp/life/facilities.html","https://u-travel.hateblo.jp/entry/aogashima-5","https://iko-yo.net/facilities/45822","https://x.com/Aogashima_Vill/status/1978608958119268485","https://wadablog.com/travel/post-112.php"]}]},"n3914577849":{"checked":"2026-08-20","facts":[{"k":"access","v":"東京都武蔵村山市学園3-59-2。多摩モノレール上北台駅から徒歩15分、上北台駅から910m。","n":1,"official":true,"conflict":false,"src":["hopeken-honpo.jp","tabelog.com"],"urls":["https://hopeken-honpo.jp/","https://tabelog.com/tokyo/A1328/A132805/13066389/"]},{"k":"opening_hours","v":"火曜〜日曜10:00〜21:00、料理のラストオーダー20:30。","n":1,"official":true,"conflict":false,"src":["hopeken-honpo.jp","tabelog.com"],"urls":["https://hopeken-honpo.jp/","https://tabelog.com/tokyo/A1328/A132805/13066389/"]},{"k":"closed_days","v":"月曜定休。店舗案内には2025年7月1日からオーダーストップ時間変更と記載。","n":1,"official":true,"conflict":false,"src":["hopeken-honpo.jp","tabelog.com"],"urls":["https://hopeken-honpo.jp/","https://tabelog.com/tokyo/A1328/A132805/13066389/"]},{"k":"reservation","v":"予約不可。","n":1,"official":true,"conflict":false,"src":["hopeken-honpo.jp","tabelog.com"],"urls":["https://hopeken-honpo.jp/","https://tabelog.com/tokyo/A1328/A132805/13066389/"]},{"k":"payment_method","v":"カード不可、電子マネー不可、QRコード決済不可。","n":1,"official":true,"conflict":false,"src":["hopeken-honpo.jp","tabelog.com"],"urls":["https://hopeken-honpo.jp/","https://tabelog.com/tokyo/A1328/A132805/13066389/"]},{"k":"facility_identity","v":"村山ホープ軒 本店。ホープ軒本舗公式には、1973年に創業者の長女がホープ軒武蔵村山店を事業継承し、村山ホープ軒 本店として営業したと掲載。","n":1,"official":true,"conflict":false,"src":["hopeken-honpo.jp","tabelog.com"],"urls":["https://hopeken-honpo.jp/","https://tabelog.com/tokyo/A1328/A132805/13066389/"]},{"k":"solo_insight","v":{"title":"村山ホープ軒 本店で上北台15分と20時30分を逆算する","insight":"「村山ホープ軒 本店。ホープ軒本舗公式には、1973年に創業者の長女がホープ軒武蔵村山店を事業継承し、村山ホープ軒 本店として営業したと掲載。」という沿革を持つ一軒です。「東京都武蔵村山市学園3-59-2。多摩モノレール上北台駅から徒歩15分、上北台駅から910m。」という地点から、夜に向かう場合は「火曜〜日曜10:00〜21:00、料理のラストオーダー20:30。」を基準に上北台駅を出る時刻を逆算します。定休日は「月曜定休。店舗案内には2025年7月1日からオーダーストップ時間変更と記載。」とされるため、月曜を避けるだけでなく、営業枠は来店前に最新案内を見直します。予約は「予約不可。」とされ、支払いも「カード不可、電子マネー不可、QRコード決済不可。」なので、一人で向かう日は予約待ち合わせを前提にせず、現金を用意したうえで駅からの徒歩時間を確保する組み立てです。","anchors":["村山ホープ軒 本店。ホープ軒本舗公式には、1973年に創業者の長女がホープ軒武蔵村山店を事業継承し、村山ホープ軒 本店として営業したと掲載。","東京都武蔵村山市学園3-59-2。多摩モノレール上北台駅から徒歩15分、上北台駅から910m。","火曜〜日曜10:00〜21:00、料理のラストオーダー20:30。","月曜定休。店舗案内には2025年7月1日からオーダーストップ時間変更と記載。","予約不可。","カード不可、電子マネー不可、QRコード決済不可。"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["hopeken-honpo.jp","tabelog.com"],"urls":["https://hopeken-honpo.jp/","https://tabelog.com/tokyo/A1328/A132805/13066389/"]}]},"manual-tokyo-hitorisauna-plus-ebisu-20260813":{"checked":"2026-08-13","facts":[{"conflict":false,"k":"solo_ok","n":1,"official":true,"src":["1sauna.jp"],"urls":["https://1sauna.jp/"],"v":"yes"},{"conflict":false,"k":"price","n":1,"official":true,"src":["1sauna.jp"],"urls":["https://1sauna.jp/"],"v":"60分3,800円、90分4,300円〜"},{"conflict":false,"k":"reservation","n":1,"official":true,"src":["1sauna.jp"],"urls":["https://1sauna.jp/"],"v":"完全予約制"},{"conflict":false,"k":"hours","n":1,"official":true,"src":["1sauna.jp"],"urls":["https://1sauna.jp/"],"v":"平日10:20〜23:00、土日祝10:00〜23:00"},{"conflict":false,"k":"bring_towel","n":1,"official":true,"src":["1sauna.jp"],"urls":["https://1sauna.jp/"],"v":"included"},{"k":"solo_insight","v":{"title":"ひとりサウナプラス恵比寿の予約計画","insight":"ひとりサウナプラス恵比寿は完全予約制のため、平日10:20〜23:00・土日祝10:00〜23:00の営業時間内で開始時刻を予約します。利用時間は60分3,800円か90分4,300円〜から選べ、タオルは用意されています。予約時に開始時刻と希望の時間枠を決めておくと手続きがスムーズです。","anchors":["完全予約制","平日10:20〜23:00、土日祝10:00〜23:00","60分3,800円、90分4,300円〜"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["1sauna.jp","google.com"],"urls":["https://1sauna.jp/","https://www.google.com/maps/search/?api=1&query=%E3%81%B2%E3%81%A8%E3%82%8A%E3%82%B5%E3%82%A6%E3%83%8A%E3%83%97%E3%83%A9%E3%82%B9%20%E6%81%B5%E6%AF%94%E5%AF%BF"]}],"sources":["https://www.google.com/maps/search/?api=1&query=%E3%81%B2%E3%81%A8%E3%82%8A%E3%82%B5%E3%82%A6%E3%83%8A%E3%83%97%E3%83%A9%E3%82%B9%20%E6%81%B5%E6%AF%94%E5%AF%BF"]},"manual-tokyo-roku-sauna-seiseki-20260813":{"checked":"2026-08-13","facts":[{"conflict":false,"k":"solo_ok","n":1,"official":true,"src":["rokusauna.com"],"urls":["https://rokusauna.com/"],"v":"yes"},{"conflict":false,"k":"price","n":1,"official":true,"src":["rokusauna.com"],"urls":["https://rokusauna.com/"],"v":"80分1名3,960円、100分1名4,510円、120分1名5,000円"},{"conflict":false,"k":"reservation","n":1,"official":true,"src":["rokusauna.com"],"urls":["https://rokusauna.com/"],"v":"完全予約制"},{"conflict":false,"k":"bring_towel","n":1,"official":true,"src":["rokusauna.com"],"urls":["https://rokusauna.com/"],"v":"included"},{"k":"solo_insight","v":{"title":"聖蹟桜ヶ丘店の予約枠と料金案内","insight":"ROKU SAUNA 聖蹟桜ヶ丘店は完全予約制のため、事前に来店日時を確定し、80分・100分・120分のいずれかの利用枠と対応する1名料金（例：80分1名3,960円）を選びます。タオルは用意（included）のため持参不要を前提に計画してください。","anchors":["完全予約制","80分1名3,960円","included","1名"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["rokusauna.com","google.com"],"urls":["https://rokusauna.com/","https://rokusauna.com/shop/kantou/tokyo/seisekisakuragaoka/","https://www.google.com/maps/search/?api=1&query=ROKU%20SAUNA%20%E8%81%96%E8%B9%9F%E6%A1%9C%E3%83%B6%E4%B8%98"]}],"sources":["https://www.google.com/maps/search/?api=1&query=ROKU%20SAUNA%20%E8%81%96%E8%B9%9F%E6%A1%9C%E3%83%B6%E4%B8%98","https://rokusauna.com/shop/kantou/tokyo/seisekisakuragaoka/"]},"manual-tokyo-private-sauna-ladle-20260813":{"checked":"2026-08-20","facts":[{"conflict":false,"k":"solo_ok","n":1,"official":true,"src":["sauna-ladle.com"],"urls":["https://sauna-ladle.com/information/","https://sauna-ladle.com/facility/"],"v":"公式料金表に1名様利用（60分・80分・100分）を掲載。施設案内では1名様ルームを案内。"},{"conflict":false,"k":"price","n":1,"official":true,"src":["sauna-ladle.com"],"urls":["https://sauna-ladle.com/information/"],"v":"1名様利用は60分3,980円、80分4,980円、100分5,980円（税込）。曜日割引の料金は公式で要確認。"},{"conflict":false,"k":"reservation","n":1,"official":true,"src":["sauna-ladle.com"],"urls":["https://sauna-ladle.com/reserve/"],"v":"完全予約制。インターネットによる事前予約のみ。予約は開始時間10分前まで可能で、予約時間の5分前に来店する公式案内。"},{"conflict":false,"k":"hours","n":1,"official":true,"src":["sauna-ladle.com"],"urls":["https://sauna-ladle.com/information/"],"v":"定休日なし。12:50〜22:10（最終入室）。"},{"conflict":false,"k":"towel","n":1,"official":true,"src":["sauna-ladle.com"],"urls":["https://sauna-ladle.com/information/"],"v":"バスタオル・フェイスタオルを無料レンタル。"},{"conflict":false,"k":"access","n":1,"official":true,"src":["sauna-ladle.com"],"urls":["https://sauna-ladle.com/information/"],"v":"東京都品川区西五反田1丁目4-4 西五反田タテイシビル5F。JR五反田駅西口 徒歩1分。"},{"conflict":false,"k":"conditions","n":1,"official":true,"src":["sauna-ladle.com"],"urls":["https://sauna-ladle.com/reserve/","https://sauna-ladle.com/facility/"],"v":"完全個室。2名・3名利用は同性のみで男女利用不可。飲酒時または37.5℃以上の発熱時は利用不可。予約開始時刻に遅れてもチェックアウト時刻は変わらず、予約時間から30分経過で当日キャンセル扱い。緊急時は従業員が入室する場合あり。"},{"k":"solo_insight","v":{"title":"五反田駅西口1分、5分前到着で使う予約制の一名個室サウナ","insight":"プライベートサウナLadleは、JR五反田駅西口 徒歩1分にあり、定休日なし。12:50〜22:10（最終入室）の枠で利用できます。1名様利用は60分3,980円、80分4,980円、100分5,980円（税込）なので、駅に着く時刻から希望の滞在時間を逆算できます。完全予約制。インターネットによる事前予約のみ。予約は開始時間10分前まで可能で、予約時間の5分前に来店する公式案内です。開始に遅れてもチェックアウト時刻は変わらず、30分経過で当日キャンセル扱いとなるため、駅西口からの1分を余裕としてではなく到着時刻を守るために使う計画が向きます。バスタオル・フェイスタオルを無料レンタルできるため、予約時刻と一名プランを決めてから手荷物を絞れます。","anchors":["JR五反田駅西口 徒歩1分","定休日なし。12:50〜22:10（最終入室）。","1名様利用は60分3,980円、80分4,980円、100分5,980円（税込）。","完全予約制。インターネットによる事前予約のみ。予約は開始時間10分前まで可能で、予約時間の5分前に来店する公式案内。","バスタオル・フェイスタオルを無料レンタル。"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["sauna-ladle.com"],"urls":["https://sauna-ladle.com/information/","https://sauna-ladle.com/facility/","https://sauna-ladle.com/reserve/"]}],"sources":[]},"n6785091986":{"checked":"2026-08-13","facts":[{"conflict":false,"k":"price","n":1,"official":true,"src":["kamata-onsen.com"],"urls":["https://kamata-onsen.com/"],"v":"大人入浴料600円、サウナ利用料金300円。"},{"conflict":false,"k":"hours","n":1,"official":true,"src":["kamata-onsen.com"],"urls":["https://kamata-onsen.com/"],"v":"年中無休10:00〜24:00。"},{"conflict":false,"k":"towel","n":1,"official":true,"src":["kamata-onsen.com"],"urls":["https://kamata-onsen.com/"],"v":"手ぶらセット（入浴料込み）900円。レンタルバスタオル200円、フェイスタオル50円。"},{"conflict":false,"k":"payment_method","n":1,"official":true,"src":["kamata-onsen.com"],"urls":["https://kamata-onsen.com/"],"v":"支払いは現金のみ。"},{"conflict":false,"k":"conditions","n":1,"official":true,"src":["kamata-onsen.com"],"urls":["https://kamata-onsen.com/"],"v":"暴力団関係者、泥酔者、皮膚疾患等の伝染のおそれがある者、排泄を自力でコントロールできない者は入店不可。"},{"conflict":false,"k":"silence","n":1,"official":false,"src":["kamata-onsen.com"],"urls":["https://kamata-onsen.com/"],"v":"会話ルールは公式に確認できないため、会話環境は要確認。"},{"k":"solo_insight","v":{"title":"蒲田温泉：現金とタオルで入浴準備","insight":"蒲田温泉は年中無休10:00〜24:00の営業で、支払いは現金のみです。入浴料600円・サウナ300円のほか、手ぶらセット900円やレンタルバスタオル200円・フェイスタオル50円があり、現金とタオルの有無を事前に決め、暴力団関係者や泥酔者、皮膚疾患等に該当しない状態で訪れてください。","anchors":["年中無休10:00〜24:00。","支払いは現金のみ。","大人入浴料600円、サウナ利用料金300円。","手ぶらセット（入浴料込み）900円。"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["kamata-onsen.com"],"urls":["https://kamata-onsen.com/"]}],"sources":["https://kamata-onsen.com/"]},"manual-tokyo-shinagawa-sauna-oimachi-20260813":{"checked":"2026-08-13","facts":[{"conflict":false,"k":"hours","n":1,"official":true,"src":["shinagawa-sauna.com"],"urls":["https://www.shinagawa-sauna.com/"],"v":"サウナ営業時間5:30〜深夜2:30。最終受付は深夜1:00、2:30〜5:30は清掃・メンテナンスのため温浴エリア利用不可。"},{"conflict":false,"k":"towel","n":1,"official":true,"src":["shinagawa-sauna.com"],"urls":["https://www.shinagawa-sauna.com/"],"v":"無料アメニティ（化粧水、乳液、洗顔料、シャンプー等）あり。タオルセット・館内着は有料レンタル。"},{"conflict":false,"k":"payment_method","n":1,"official":true,"src":["shinagawa-sauna.com"],"urls":["https://www.shinagawa-sauna.com/"],"v":"現金、主要クレジットカード、電子マネー、コード決済に対応。"},{"conflict":false,"k":"conditions","n":1,"official":true,"src":["shinagawa-sauna.com"],"urls":["https://www.shinagawa-sauna.com/"],"v":"タトゥー・入れ墨は利用不可。サウナ・温浴エリア、脱衣所、トイレは撮影不可。駐輪場・駐車場なし。"},{"conflict":false,"k":"silence","n":1,"official":false,"src":["一人マップ監査"],"urls":[],"v":"会話ルールは公式に確認できないため、会話環境は要確認。"},{"k":"solo_insight","v":{"title":"品川サウナ：深夜利用の持ち物案内","insight":"サウナ営業時間は5:30〜深夜2:30、最終受付は深夜1:00のため到着は最終受付前にします。支払いは現金・主要クレジットカード・電子マネー・コード決済が利用可能。タオルセット・館内着は有料レンタル、化粧水等は無料アメニティ。タトゥーは利用不可、撮影は禁止、駐輪場・駐車場はなし。","anchors":["サウナ営業時間5:30〜深夜2:30","最終受付は深夜1:00","タオルセット・館内着は有料レンタル","タトゥー・入れ墨は利用不可"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["shinagawa-sauna.com","navitime.co.jp"],"urls":["https://www.shinagawa-sauna.com/","https://www.navitime.co.jp/poi?spot=02022-10044332"]}],"sources":["https://www.shinagawa-sauna.com/","https://www.navitime.co.jp/poi?spot=02022-10044332"]},"manual-tokyo-smart-stay-shizuku-oimachi-20260813":{"checked":"2026-08-13","facts":[{"conflict":false,"k":"conditions","n":1,"official":true,"src":["shizuku-hotel.jp"],"urls":["https://shizuku-hotel.jp/shinagawa-oimachi/","https://shizuku-hotel.jp/shinagawa-oimachi/spa.html"],"v":"宿泊者は温浴無料。温浴のみの日帰り入浴も利用可能で、男性・女性それぞれに大浴場とサウナあり。"},{"conflict":false,"k":"hours","n":1,"official":true,"src":["shizuku-hotel.jp"],"urls":["https://shizuku-hotel.jp/shinagawa-oimachi/","https://shizuku-hotel.jp/shinagawa-oimachi/spa.html"],"v":"施設は24時間営業。温浴エリアの個別営業時間は公式に確認できないため要確認。"},{"conflict":false,"k":"towel","n":1,"official":true,"src":["shizuku-hotel.jp"],"urls":["https://shizuku-hotel.jp/shinagawa-oimachi/","https://shizuku-hotel.jp/shinagawa-oimachi/spa.html"],"v":"館内着、ボディータオル、フェイスタオル、歯ブラシ、シャンプー等のアメニティ・無料貸出品あり。"},{"conflict":false,"k":"payment_method","n":1,"official":true,"src":["shizuku-hotel.jp"],"urls":["https://shizuku-hotel.jp/shinagawa-oimachi/","https://shizuku-hotel.jp/shinagawa-oimachi/spa.html"],"v":"現金、クレジットカード、QR決済に対応。"},{"conflict":false,"k":"silence","n":1,"official":false,"src":["一人マップ監査"],"urls":[],"v":"会話ルールは公式に確認できないため、会話環境は要確認。"},{"k":"solo_insight","v":{"title":"SHIZUKU品川大井町の温浴準備","insight":"施設は24時間営業で到着時間を決めやすく、宿泊者は温浴が無料。温浴のみの日帰り入浴も利用可能で、男女別に大浴場とサウナがある点を踏まえ、現金・クレジット・QR決済のいずれかを用意し、館内着やボディータオル・フェイスタオル等の無料貸出を活用して持ち物を最小限にする利用計画を立ててください。","anchors":["24時間営業","宿泊者は温浴無料","館内着、ボディータオル、フェイスタオル"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["shizuku-hotel.jp","navitime.co.jp"],"urls":["https://shizuku-hotel.jp/shinagawa-oimachi/","https://shizuku-hotel.jp/shinagawa-oimachi/spa.html","https://www.navitime.co.jp/poi?name=%E6%9D%B1%E4%BA%AC%E9%83%BD%E5%93%81%E5%B7%9D%E5%8C%BA%E6%9D%B1%E5%A4%A7%E4%BA%955%E4%B8%81%E7%9B%AE2-8&address=131090160050000200004"]}],"sources":["https://shizuku-hotel.jp/shinagawa-oimachi/","https://shizuku-hotel.jp/shinagawa-oimachi/spa.html","https://www.navitime.co.jp/poi?name=%E6%9D%B1%E4%BA%AC%E9%83%BD%E5%93%81%E5%B7%9D%E5%8C%BA%E6%9D%B1%E5%A4%A7%E4%BA%955%E4%B8%81%E7%9B%AE2-8&address=131090160050000200004"]},"n6712204417":{"checked":"2026-08-13","facts":[{"conflict":false,"k":"price","n":1,"official":true,"src":["spa-nagomi.com"],"urls":["https://www.spa-nagomi.com/","https://www.spa-nagomi.com/rate.html"],"v":"平日大人5時間2,680円・70分1,880円、休日5時間2,980円・70分2,180円。"},{"conflict":false,"k":"hours","n":1,"official":true,"src":["spa-nagomi.com"],"urls":["https://www.spa-nagomi.com/","https://www.spa-nagomi.com/rate.html"],"v":"SPA利用時間11:00〜翌9:00、最終受付翌8:00。"},{"conflict":false,"k":"towel","n":1,"official":true,"src":["spa-nagomi.com"],"urls":["https://www.spa-nagomi.com/","https://www.spa-nagomi.com/rate.html"],"v":"料金にフェイス・バスタオル、館内着、アメニティ利用を含む。"},{"conflict":false,"k":"payment_method","n":1,"official":true,"src":["spa-nagomi.com"],"urls":["https://www.spa-nagomi.com/","https://www.spa-nagomi.com/rate.html"],"v":"主要クレジットカード、電子マネー、QR決済に対応。"},{"conflict":false,"k":"reservation","n":1,"official":true,"src":["spa-nagomi.com"],"urls":["https://www.spa-nagomi.com/","https://www.spa-nagomi.com/rate.html"],"v":"ランチパック、岩盤浴の日、お泊りパックは予約不要。通常SPA利用の予約要否は利用前に要確認。"},{"conflict":false,"k":"conditions","n":1,"official":true,"src":["spa-nagomi.com"],"urls":["https://www.spa-nagomi.com/","https://www.spa-nagomi.com/rate.html"],"v":"刺青・タトゥー・ペイントシール、暴力団関係者、泥酔者、他の利用者へ迷惑をかける者、暴言・暴力・威嚇行為をする者は入館不可。"},{"conflict":false,"k":"silence","n":1,"official":false,"src":["一人マップ監査"],"urls":[],"v":"会話ルールは公式に確認できないため、会話環境は要確認。"},{"k":"solo_insight","v":{"title":"SPA&HOTEL和の滞在計画ガイド","insight":"滞在はSPA利用時間11:00〜翌9:00（最終受付翌8:00）を基準にし、平日・休日の5時間／70分の料金から滞在時間を決めます。料金にフェイス・バスタオル・館内着・アメニティが含まれ、主要クレジットカード・電子マネー・QR決済で支払い可能。ランチパック・岩盤浴日・お泊りパックは予約不要で、通常のSPA利用については事前に施設へお問い合わせください。刺青・タトゥーのある方は入館不可です。","anchors":["SPA利用時間11:00〜翌9:00","平日大人5時間2,680円・70分1,880円","料金にフェイス・バスタオル、館内着、アメニティ利用を含む"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["spa-nagomi.com"],"urls":["https://www.spa-nagomi.com/","https://www.spa-nagomi.com/rate.html"]}],"sources":["https://www.spa-nagomi.com/","https://www.spa-nagomi.com/rate.html"]},"manual-tokyo-hubhub-shimokitazawa-20260813":{"checked":"2026-08-13","facts":[{"conflict":false,"k":"solo_ok","n":1,"official":true,"src":["hubhub.jp"],"urls":["https://hubhub.jp/facility/shimokitazawa"],"v":"公式は手ぶら・予約不要のパブリックサウナで「おひとり様も大歓迎」と案内し、平日限定の「おひとりととのいプラン」も掲載。"},{"conflict":false,"k":"price","n":1,"official":true,"src":["hubhub.jp"],"urls":["https://hubhub.jp/facility/shimokitazawa"],"v":"公式掲載ではパブリックサウナ2,000円〜、平日限定おひとりととのいプラン3,000円〜、最大4名の貸切8,000円〜、最大6名の貸切10,000円〜。プラン・日時による変動は予約時に確認。"},{"conflict":false,"k":"reservation","n":1,"official":true,"src":["hubhub.jp"],"urls":["https://hubhub.jp/facility/shimokitazawa"],"v":"パブリックサウナは予約不要。公式の利用の流れでは貸切を含む利用についてWEB予約から案内しているため、利用プランごとの予約要否は確認。"},{"conflict":false,"k":"hours","n":1,"official":true,"src":["hubhub.jp"],"urls":["https://hubhub.jp/facility/shimokitazawa"],"v":"月〜金、土・日とも09:00〜23:00。定休日なし（施設メンテナンス等で臨時休業する場合あり）。"},{"conflict":false,"k":"towel","n":1,"official":true,"src":["hubhub.jp"],"urls":["https://hubhub.jp/facility/shimokitazawa"],"v":"ドロップイン・プライベートサウナとも、無料フェイスタオル・バスタオル各1枚、化粧水、乳液、クレンジング、ヘアドライヤーを公式案内。"},{"conflict":false,"k":"conditions","n":1,"official":true,"src":["hubhub.jp"],"urls":["https://hubhub.jp/facility/shimokitazawa"],"v":"未就学児および事前に利用規約へ同意できない人は利用不可。タトゥーがある人は貸切サウナのみ利用可。"},{"conflict":false,"k":"silence","n":1,"official":true,"src":["hubhub.jp"],"urls":["https://hubhub.jp/facility/shimokitazawa"],"v":"公式FAQはHUBHUBのサウナをコミュニケーションの場とし、会話可能と案内。ただし他の利用者へ配慮するよう案内しているため、静かな利用を望む場合は要確認。"},{"k":"solo_insight","v":{"title":"平日おひとり枠と手ぶら利用の下北沢","insight":"HUBHUB下北沢はパブリックサウナが予約不要で「おひとり様も大歓迎」と公式案内。平日限定のおひとりととのいプランは三千円〜。無料フェイスタオル・バスタオル各一枚と基礎アメニティが用意されているため、手ぶらで平日枠を予約や時短利用と組み合わせる計画が立てやすい。営業時間は九時〜二十三時。","anchors":["おひとり様も大歓迎","平日限定おひとりととのいプラン","無料フェイスタオル・バスタオル各1枚"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["hubhub.jp","local.google.co.jp"],"urls":["https://hubhub.jp/facility/shimokitazawa","https://local.google.co.jp/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E4%B8%96%E7%94%B0%E8%B0%B7%E5%8C%BA%E4%BB%A3%E6%B2%A25-8-6"]}],"sources":["https://hubhub.jp/facility/shimokitazawa","https://local.google.co.jp/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E4%B8%96%E7%94%B0%E8%B0%B7%E5%8C%BA%E4%BB%A3%E6%B2%A25-8-6"]},"manual-tokyo-sava-ikejiri-20260813":{"checked":"2026-08-15","facts":[{"conflict":false,"k":"price","n":1,"official":true,"src":["sava.storeinfo.jp"],"urls":["https://sava.storeinfo.jp/pages/7161184/menu"],"v":"公式の体験利用は120分平日5,800円〜、休日10,300円〜。初回新規のみ1回限り・2名まで・入会金不要。会員向けスポット等は120分5,800円〜11,700円で、金額変動の可能性を案内。"},{"conflict":false,"k":"reservation","n":1,"official":true,"src":["sava.storeinfo.jp"],"urls":["https://sava.storeinfo.jp/pages/7161263/page_202307262222"],"v":"公式の利用の流れは事前予約が必須とし、原則として電話予約・直接来店では利用できないと案内。"},{"conflict":false,"k":"towel","n":1,"official":true,"src":["sava.storeinfo.jp"],"urls":["https://sava.storeinfo.jp/pages/7161263/page_202307262222"],"v":"公式はバスタオル2枚、化粧水、洗顔フォーム、クレンジング、シャンプー、コンディショナー、ボディソープ等を案内。水着は持参で貸出なし。"},{"conflict":false,"k":"conditions","n":1,"official":true,"src":["sava.storeinfo.jp"],"urls":["https://sava.storeinfo.jp/pages/7161184/menu"],"v":"公式は水着着用、最大2名、18歳未満利用不可、予約60分前を過ぎるとキャンセル不可を案内。健康状態等による利用制限は公式規約を確認。"},{"conflict":false,"k":"private_room","n":1,"official":true,"src":["sava.storeinfo.jp"],"urls":["https://sava.storeinfo.jp/"],"v":"公式は約50.24㎡の完全個室にサウナ、シャワー、トイレ、パウダールームを設け、定員を最大2名と案内。公式の一人利用個別明示は確認できないため、1名利用可とは扱わない。"},{"conflict":false,"k":"silence","n":1,"official":false,"src":["一人マップ監査"],"urls":[],"v":"会話環境の公式ルールは今回確認できないため、利用前に要確認。"},{"k":"solo_insight","v":{"title":"約50.24㎡の個室で使う120分枠準備","insight":"公式は約50.24㎡の完全個室にサウナ・シャワー・トイレ・パウダールームを備え、初回体験は120分枠で案内します。利用は事前予約が必須で、バスタオル2枚や洗顔フォーム等は用意され、水着は持参が必要です。定員は最大2名、18歳未満利用不可の条件もあります。","anchors":["約50.24㎡の完全個室","120分","事前予約が必須","水着は持参"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["sava.storeinfo.jp","local.google.co.jp"],"urls":["https://sava.storeinfo.jp/pages/7161184/menu","https://sava.storeinfo.jp/pages/7161263/page_202307262222","https://sava.storeinfo.jp/","https://sava.storeinfo.jp/pages/7161262/page_202307262221","https://local.google.co.jp/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E4%B8%96%E7%94%B0%E8%B0%B7%E5%8C%BA%E6%B1%A0%E5%B0%BB3-23-5"]}],"sources":["https://sava.storeinfo.jp/","https://sava.storeinfo.jp/pages/7161184/menu","https://sava.storeinfo.jp/pages/7161263/page_202307262222","https://sava.storeinfo.jp/pages/7161262/page_202307262221","https://local.google.co.jp/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E4%B8%96%E7%94%B0%E8%B0%B7%E5%8C%BA%E6%B1%A0%E5%B0%BB3-23-5"]},"manual-tokyo-sauna3-mishuku-20260815":{"checked":"2026-08-15","facts":[{"conflict":false,"k":"solo_ok","n":1,"official":true,"src":["s3cgrs.jp"],"urls":["https://s3cgrs.jp/"],"v":"公式は2階QUICK ROOMの60分・140分、3階VIP ROOMの80分・180分について、いずれも「1名様」プランを掲載。"},{"conflict":false,"k":"price","n":1,"official":true,"src":["s3cgrs.jp"],"urls":["https://s3cgrs.jp/"],"v":"公式の平日料金は2階QUICK ROOMが60分2,200円、140分4,400円。3階VIP ROOMが80分6,000円、180分12,000円。土日祝は追加300円を案内。"},{"conflict":false,"k":"hours","n":1,"official":true,"src":["s3cgrs.jp"],"urls":["https://s3cgrs.jp/"],"v":"公式は営業時間08:00〜24:10、不定休と案内。"},{"conflict":false,"k":"towel","n":1,"official":true,"src":["s3cgrs.jp"],"urls":["https://s3cgrs.jp/"],"v":"公式は1人あたりバスタオル・フェイスタオル各1枚を用意し、2階に化粧水・乳液、3階にクレンジング等のスキンケアセットを案内。"},{"conflict":false,"k":"reservation","n":1,"official":true,"src":["s3cgrs.jp"],"urls":["https://s3cgrs.jp/"],"v":"公式はWeb、直接来店、電話での予約を案内。Web予約はクレジットカード決済、店頭ではクレジットカード、Apple Pay、交通系IC、各種QR決済を案内。"},{"conflict":false,"k":"private_room","n":1,"official":true,"src":["s3cgrs.jp"],"urls":["https://s3cgrs.jp/"],"v":"公式は2階をドライサウナと冷水/温水シャワーの1名プラン、3階をドライ/スチームサウナ、水風呂、温水シャワーの1〜3名プランとして案内。"},{"conflict":false,"k":"conditions","n":1,"official":true,"src":["s3cgrs.jp"],"urls":["https://s3cgrs.jp/"],"v":"公式は3階VIP ROOMを同性同士の利用に限定し、全室禁煙、キャンセルは予約日前日17:00まで無料と案内。"},{"conflict":false,"k":"silence","n":1,"official":false,"src":["一人マップ監査"],"urls":[],"v":"会話環境の公式ルールは今回確認できないため、利用前に要確認。"},{"k":"solo_insight","v":{"title":"三宿Sauna3の階別1名プラン選び","insight":"Sauna3は2階QUICK ROOMの「1名様」60分・140分枠と3階VIP ROOMの「1名様」80分・180分枠を公式に掲載。2階はドライサウナと冷水／温水シャワー、3階は水風呂とスチームを備え、Web予約はクレジット決済、店頭は各種キャッシュレスが利用可能です。バスタオル・フェイスタオルは各1枚用意され、キャンセルは予約日前日17:00まで無料です。","anchors":["2階QUICK ROOM","60分・140分","3階VIP ROOM","1人あたりバスタオル・フェイスタオル各1枚"],"quality":"grounded","policyVersion":"official-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["s3cgrs.jp","msearch.gsi.go.jp"],"urls":["https://s3cgrs.jp/","https://msearch.gsi.go.jp/address-search/AddressSearch?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E4%B8%96%E7%94%B0%E8%B0%B7%E5%8C%BA%E4%B8%89%E5%AE%BF1-25-2"]}],"sources":["https://s3cgrs.jp/","https://msearch.gsi.go.jp/address-search/AddressSearch?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E4%B8%96%E7%94%B0%E8%B0%B7%E5%8C%BA%E4%B8%89%E5%AE%BF1-25-2"]},"manual-tokyo-villa-fontaine-ariake-private-sauna-20260818":{"checked":"2026-08-19","facts":[{"k":"solo_ok","v":"90分・1名利用は平日6,000円、休日7,000円","n":1,"official":true,"conflict":false,"src":["hvf.jp"],"urls":["https://www.hvf.jp/ariake-grand/spa3.html","https://www.hvf.jp/ariake-grand/access.html"]},{"k":"private_room","v":"プライベートスペースを確保した個室サウナ","n":1,"official":true,"conflict":false,"src":["hvf.jp"],"urls":["https://www.hvf.jp/ariake-grand/spa3.html","https://www.hvf.jp/ariake-grand/access.html"]},{"k":"opening_hours","v":"6:00〜24:00（最終入場22:30）","n":1,"off
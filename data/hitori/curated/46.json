cial-provenance-v2"},"n":1,"official":true,"conflict":false,"src":["town.nagashima.lg.jp"],"urls":["https://www.town.nagashima.lg.jp/sightseeing/si0021/"]}]},"r7452097":{"checked":"2026-09-02","facts":[{"k":"payment_method","v":"cashless_ok","n":1,"official":false,"conflict":false,"src":["openstreetmap.org"],"urls":["https://www.openstreetmap.org/relation/7452097"],"quote":"payment:credit_cards=yes, payment:visa=yes, payment:mastercard=yes, payment:debit_cards=yes","checked":"2026-09-02"}]}}
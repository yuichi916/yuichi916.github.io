{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(curl -s https://api.pcloud.com/*)",
      "Bash(curl -sI https://niwa-cors.yuichi916.workers.dev/*)",
      "Bash(curl -sL https://gc.zgo.at/count.js)",
      "Bash(curl -sL https://unpkg.com/three@*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(ssh *)",
      "Bash(> /dev/*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(npm publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hook": "bash .claude/hooks/pre-bash-warn.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hook": "bash .claude/hooks/post-write-secret-scan.sh"
      }
    ],
    "Stop": [
      {
        "hook": "bash .claude/hooks/stop-validate.sh"
      }
    ]
  }
}
